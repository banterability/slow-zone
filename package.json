{
  "name": "slow-zone",
  "version": "5.0.1",
  "description": "A client & wrapper for CTA 'L' arrival data",
  "author": "Jeff Long",
  "license": "MIT",
  "exports": "./dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banterability/slow-zone.git"
  },
  "bugs": {
    "url": "https://github.com/banterability/slow-zone/issues"
  },
  "homepage": "https://github.com/banterability/slow-zone",
  "keywords": [
    "cta",
    "subway",
    "chicago",
    "l",
    "public transit"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js"
  ],
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "dateline": "^5.1.0"
  }
}
