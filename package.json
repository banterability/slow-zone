{
  "name": "slow-zone",
  "version": "6.0.0",
  "description": "A client & wrapper for CTA 'L' arrival data",
  "keywords": [
    "chicago",
    "cta",
    "l",
    "public transit",
    "subway"
  ],
  "homepage": "https://github.com/banterability/slow-zone",
  "bugs": {
    "url": "https://github.com/banterability/slow-zone/issues"
  },
  "license": "MIT",
  "author": "Jeff Long",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banterability/slow-zone.git"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dateline": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
